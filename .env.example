CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Bot display name in chats
ASSISTANT_NAME="Thomas"

# Anthropic API key (for agent containers)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Model selection: execution containers use CLAUDE_MODEL, main group + router use CLAUDE_ROUTER_MODEL
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_ROUTER_MODEL=claude-opus-4-6

# Telegram Bot API token (from @BotFather). Leave empty to disable Telegram.
TELEGRAM_BOT_TOKEN=

# Airtable PAT for master commit tracking (optional)
MASTER_COMMIT_PAT=

# Web scraping (Firecrawl MCP)
FIRECRAWL_API_KEY=

# Web search (exa) — pending package name resolution
# EXA_API_KEY=
